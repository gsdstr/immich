# Local development environment configuration for macOS
# Connects to remote infrastructure running on hl-win

# Remote database on hl-win
DB_HOSTNAME=hl-win.local
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Remote cache and job queues on hl-win
REDIS_HOSTNAME=hl-win.local
REDIS_PORT=6379

# Local high-performance ML running natively with Apple Silicon (MPS / CoreML)
IMMICH_MACHINE_LEARNING_URL=http://localhost:3003

# Read-only photo directory mounted via SMB from hl-win, or local test directory
UPLOAD_LOCATION=/Volumes/Photos-ReadOnly
